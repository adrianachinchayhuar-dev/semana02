<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Estudiantes</title>
  <style>
    .destacado { background-color: #d4edda; font-weight: bold; }
    table, th, td { border: 1px solid black; border-collapse: collapse; padding: 8px; }
  </style>
</head>
<body>
  <h2>Tabla de Estudiantes</h2>
  <table>
    <thead>
      <tr><th>Nombre</th><th>Nota</th></tr>
    </thead>
    <tbody>
      {{#each students}}
      <tr class="{{#if isTop}}destacado{{/if}}">
        <td>{{this.name}}</td>
        <td>{{this.grade}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>